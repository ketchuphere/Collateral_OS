{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@collateral-os/db": ["./packages/db/src/index.ts"],
      "@collateral-os/api-client-react": ["./packages/api-client-react/src/index.ts"],
      "@collateral-os/api-zod": ["./packages/api-zod/src/index.ts"]
    }
  }
}

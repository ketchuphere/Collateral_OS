# ============================================================
# CollateralOS — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# ── Required ─────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/collateral_os

# Groq API key — obtain from https://console.groq.com
GROQ_API_KEY=gsk_...

# ── Optional ─────────────────────────────────────────────────

# API server port (default: 5000)
PORT=5000

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# CORS origin for the frontend (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development

# ── Feature Flags ─────────────────────────────────────────────

# Enable vector store RAG (requires pgvector or Pinecone setup)
# Default: false (uses full-context injection RAG)
ENABLE_VECTOR_RAG=false

# ── Optional: Vector Store (required if ENABLE_VECTOR_RAG=true) ─

# Pinecone (managed vector DB)
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX=collateral-os

# ── Optional: Embedding Model (required if ENABLE_VECTOR_RAG=true) ─

# OpenAI (for text-embedding-3-small)
# OPENAI_API_KEY=sk-...
